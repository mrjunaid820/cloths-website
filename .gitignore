# ==============================================================================
# AURA ATELIER — Git Ignore Rules
# ==============================================================================

# Node dependencies
node_modules/
client/node_modules/

# Production build artifacts
dist/
client/dist/

# SQLite ephemeral runtime locks and backups (keeps main ecommerce.db intact)
server/*.db-wal
server/*.db-shm
server/*.bak

# Local environment secrets
.env
.env.local
.env.*.local

# Logs and debug output
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Operating system files
.DS_Store
Thumbs.db

# IDE and Editor configurations
.vscode/
.idea/
*.swp
*.swo
